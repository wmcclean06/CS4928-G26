 "locked": false,
 "title": "If 2 libs have same .h file, use the lib with same dir name",
 "user": {
  "login": "PaulStoffregen",
  "id": 965463,
  "node_id": "MDQ6VXNlcjk2NTQ2Mw==",
  "avatar_url": "https://avatars.githubusercontent.com/u/965463?v=4",
