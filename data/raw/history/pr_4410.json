 "title": "Removed unnecessary invocation of Ethernet.maintain()",
 "user": {
  "login": "michaelamie",
  "id": 1023368,
  "node_id": "MDQ6VXNlcjEwMjMzNjg=",
  "avatar_url": "https://avatars.githubusercontent.com/u/1023368?v=4",
  "gravatar_id": "",
  "url": "https://api.github.com/users/michaelamie",
  "html_url": "https://github.com/michaelamie",
  "followers_url": "https://api.github.com/users/michaelamie/followers",
  "following_url": "https://api.github.com/users/michaelamie/following{/other_user}",
  "gists_url": "https://api.github.com/users/michaelamie/gists{/gist_id}",
  "starred_url": "https://api.github.com/users/michaelamie/starred{/owner}{/repo}",
  "subscriptions_url": "https://api.github.com/users/michaelamie/subscriptions",
  "organizations_url": "https://api.github.com/users/michaelamie/orgs",
  "repos_url": "https://api.github.com/users/michaelamie/repos",
  "events_url": "https://api.github.com/users/michaelamie/events{/privacy}",
  "received_events_url": "https://api.github.com/users/michaelamie/received_events",
  "type": "User",
