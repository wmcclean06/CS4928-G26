 "locked": false,
 "title": "Fixed ignoring of LIBRARY_INDEX_URL system property",
 "user": {
  "login": "xardael",
  "id": 1083252,
  "node_id": "MDQ6VXNlcjEwODMyNTI=",
  "avatar_url": "https://avatars.githubusercontent.com/u/1083252?v=4",
  "gravatar_id": "",
  "url": "https://api.github.com/users/xardael",
  "html_url": "https://github.com/xardael",
  "followers_url": "https://api.github.com/users/xardael/followers",
  "following_url": "https://api.github.com/users/xardael/following{/other_user}",
  "gists_url": "https://api.github.com/users/xardael/gists{/gist_id}",
  "starred_url": "https://api.github.com/users/xardael/starred{/owner}{/repo}",
