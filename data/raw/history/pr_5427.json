 "title": "Set default values for Arduino AVR Boards upload.verify and program.verify",
 "user": {
  "login": "per1234",
  "id": 8572152,
  "node_id": "MDQ6VXNlcjg1NzIxNTI=",
  "avatar_url": "https://avatars.githubusercontent.com/u/8572152?v=4",
  "gravatar_id": "",
