# CS4928-G26 Docker configuration - copy this file to .env and fill it in.
#   cp .env.example .env
# .env is not committed and not copied into the image (see .dockerignore).

# ---------------------------------------------------------------- required --
# GitHub token: read-only fine-grained token for public repositories, the
# Docker equivalent of the GITHUB_TOKEN system environment variable recorded
# in the run procedure. Used by scripts/fetch_pr_data.py and by `run.sh
# create-save` (the server clones arduino/Arduino with it).
GITHUB_TOKEN=

# Neo4j authentication, format user/password. The password must be at least
# 8 characters and must not be 'neo4j' (Neo4j requirements). It sets the
# initial password on the FIRST container start only; keep it stable across
# restarts or delete the cs4928_g26_neo4j_data volume to start fresh.
NEO4J_AUTH=neo4j/change-me-please

# ---------------------------------------------------------------- required --
# Credentials the callgraph-server (neo4j.uri / neo4j.username /
# neo4j.password via Spring relaxed binding) and the run.sh helper commands
# use to connect. Keep NEO4J_PASSWORD identical to the password part of
# NEO4J_AUTH.
NEO4J_URI=bolt://localhost:7687
NEO4J_USERNAME=neo4j
NEO4J_PASSWORD=change-me-please
